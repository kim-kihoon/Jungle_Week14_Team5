<rml>
<head>
	<title>Game Over</title>
	<style>
		body {
			margin: 0px;
			width: 100%;
			height: 100%;
			font-family: OCRAStd;
			color: #FFFFFF;
			background-color: rgba(0, 0, 0, 0.82);
		}
		#ui_canvas {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 100%;
			height: 100%;
		}
		#game_over_title {
			position: absolute;
			left: 120px;
			top: 320px;
			width: 720px;
			height: 96px;
			font-size: 72px;
			color: #FF4747;
		}
		.game-over-button {
			position: absolute;
			display: block;
			font-family: OCRAStd;
			font-size: 48px;
			font-weight: normal;
			text-align: left;
			color: #FFFFFF;
			background-color: rgba(0, 0, 0, 0);
		}
		.game-over-button:hover {
			color: rgb(71, 255, 105);
			background-color: rgba(255, 255, 255, 0.12);
		}
	</style>
</head>
<body data-rml-ui-document="1" data-canvas-width="1920" data-canvas-height="1080" data-preview-scale="1">
	<div id="ui_canvas">
		<div id="game_over_title">Game Over</div>
		<div id="restart_button" class="game-over-button" data-rml-editor="1" data-type="Button" data-x="120.000000" data-y="480.000000" data-width="360.000000" data-height="64.000000" data-z="0" data-visible="true" data-locked="false" data-opacity="1.000000" data-bg="#00000000" data-text="Restart" data-text-color="#FFFFFFFF" data-font-size="48.000000" data-font-family="OCRAStd" data-bold="false" data-image="" data-target-tag="Player" data-on-click="RestartGame" style="position: absolute; left: 120.00px; top: 480.00px; width: 360.00px; height: 64.00px; font-size: 48.00px; font-weight: normal; text-align: left;">Restart</div>
		<div id="exit_button" class="game-over-button" data-rml-editor="1" data-type="Button" data-x="120.000000" data-y="560.000000" data-width="240.000000" data-height="64.000000" data-z="1" data-visible="true" data-locked="false" data-opacity="1.000000" data-bg="#00000000" data-text="Exit" data-text-color="#FFFFFFFF" data-font-size="48.000000" data-font-family="OCRAStd" data-bold="false" data-image="" data-target-tag="Player" data-on-click="ExitGame" style="position: absolute; left: 120.00px; top: 560.00px; width: 240.00px; height: 64.00px; font-size: 48.00px; font-weight: normal; text-align: left;">Exit</div>
	</div>
</body>
</rml>
