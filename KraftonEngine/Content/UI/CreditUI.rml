<rml>
<head>
	<title>Credit</title>
	<style>
		body {
			margin: 0px;
			width: 100%;
			height: 100%;
			font-family: OCRAStd;
			color: #FFFFFF;
			background-color: #000000;
		}
		#overlay {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 1920px;
			height: 1080px;
			background-color: #000000;
		}
		#panel_title {
			position: absolute;
			left: 120px;
			top: 150px;
			font-size: 56px;
			color: rgb(71, 255, 105);
		}
		.credit-name-col {
			position: absolute;
			top: 400px;
			width: 33.33%;
			font-size: 26px;
			text-align: center;
			color: #FFFFFF;
		}
		.credit-line {
			position: absolute;
			left: 0px;
			width: 1920px;
			font-size: 26px;
			text-align: center;
			color: #FFFFFF;
		}
		.credit-line-highlight {
			position: absolute;
			left: 0px;
			width: 1920px;
			font-size: 24px;
			text-align: center;
			color: rgb(71, 255, 105);
		}
		.text-button {
			position: absolute;
			font-size: 40px;
			color: #FFFFFF;
			background-color: rgba(0, 0, 0, 0);
		}
		.text-button:hover {
			color: rgb(71, 255, 105);
		}
	</style>
</head>
<body data-rml-ui-document="1" data-ui-layout="scaled" data-canvas-width="1920" data-canvas-height="1080" data-preview-scale="1">
	<div id="overlay">
		<div id="panel_title">Credit</div>
		<div id="credit_name_1" class="credit-name-col" style="left: 0%;">Kihoon Kim</div>
		<div id="credit_name_2" class="credit-name-col" style="left: 33.33%;">Hyeonseok Cho</div>
		<div id="credit_name_3" class="credit-name-col" style="left: 66.66%;">Park Sanghyeok</div>
		<div id="credit_special_thanks" class="credit-line-highlight" style="top: 500px;">SPECIAL THANKS TO</div>
		<div id="credit_thanks_line" class="credit-line" style="top: 550px;">Krafton Jungle Game Tech Lab</div>
		<div id="credit_back_button" class="text-button" data-rml-editor="1" data-type="Button" data-x="120.000000" data-y="950.000000" data-width="240.000000" data-height="56.000000" data-z="0" data-visible="true" data-locked="false" data-opacity="1.000000" data-bg="#00000000" data-text="Back" data-text-color="#FFFFFFFF" data-font-size="40.000000" data-font-family="OCRAStd" data-bold="false" data-image="" data-target-tag="Player" data-on-click="ClosePopup" style="position: absolute; left: 120.00px; top: 950.00px; width: 240.00px; height: 56.00px; font-size: 40.00px; font-weight: normal; text-align: left; color: #FFFFFF;">Back</div>
	</div>
</body>
</rml>
