<rml>
<head>
	<title>Hospital Door Prompt</title>
	<style>
		body {
			margin: 0px;
			width: 100%;
			height: 100%;
			font-family: OCRAStd;
		}
		#ui_canvas {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 100%;
			height: 100%;
		}
		#door_prompt {
			position: absolute;
			left: 75%;
			top: 50%;
			width: 280px;
			height: 40px;
			margin-left: -140px;
			margin-top: -20px;
			display: none;
			color: rgb(71, 255, 105);
			font-family: OCRAStd;
			font-size: 28px;
			text-align: center;
			background-color: rgba(0, 0, 0, 0);
		}
	</style>
</head>
<body data-rml-ui-document="1" data-canvas-width="1920" data-canvas-height="1080" data-preview-scale="1">
	<div id="ui_canvas">
		<div id="door_prompt">[E] Open</div>
	</div>
</body>
</rml>
