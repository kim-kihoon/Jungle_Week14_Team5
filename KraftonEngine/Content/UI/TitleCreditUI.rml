<rml>
<head>
	<title>Title Credit</title>
	<style>
		body { margin: 0px; width: 100%; height: 100%; font-family: Maplestory; }
		#panel { position:absolute; left:430px; top:150px; width:520px; height:340px; background-color:rgba(15,19,31,238); color:rgba(255,255,255,255); border-width:2px; border-color:rgba(125,176,255,255); padding:28px; }
		#title { font-size:32px; font-weight:bold; margin-bottom:24px; }
		#body { font-size:22px; line-height:34px; }
		#close_button { position:absolute; right:24px; bottom:24px; width:132px; height:44px; text-align:center; line-height:44px; background-color:rgba(26,71,140,235); color:rgba(255,255,255,255); cursor:pointer; }
	</style>
</head>
<body>
	<div id="panel">
		<div id="title">Credit</div>
		<div id="body">Krafton Jungle Week14 Team5</div>
		<div id="close_button" data-target-tag="GameManager" data-on-click="HidePopup">Close</div>
	</div>
</body>
</rml>
