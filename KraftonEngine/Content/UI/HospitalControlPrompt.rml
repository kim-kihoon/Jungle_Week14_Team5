<rml>
<head>
	<title>Hospital Control Prompt</title>
	<style>
		body {
			margin: 0px;
			width: 100%;
			height: 100%;
			font-family: OCRAStd;
		}
		#ui_canvas {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 100%;
			height: 100%;
		}
		#control_prompt {
			position: absolute;
			right: 32px;
			bottom: 32px;
			display: block;
			color: rgb(71, 255, 105);
			font-family: OCRAStd;
			font-size: 18px;
			text-align: right;
			line-height: 1.35;
			white-space: pre-line;
			background-color: rgba(0, 0, 0, 0);
		}
	</style>
</head>
<body data-rml-ui-document="1" data-canvas-width="1920" data-canvas-height="1080" data-preview-scale="1">
	<div id="ui_canvas">
		<div id="control_prompt">[LMB] Shoot<br/>[Space] Camera</div>
	</div>
</body>
</rml>
